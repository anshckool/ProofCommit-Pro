# ProofCommit Pro - Backend Environment Configuration
# Neural Storm 2026 Hackathon (JNTUH Hyderabad) | Track 1: Future Tech (FT-05)
# Sponsored by 9AM (9am.careers by TechMojo)

# Google Gemini API Key for Contextual Code Review, AST-grounded Defect Analysis, and Patch Generation
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Test Credentials (for ₹299 Verified Skill Certificate Checkout)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Supabase Credentials for Code Review Audits and Skill Certificate Registry
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
